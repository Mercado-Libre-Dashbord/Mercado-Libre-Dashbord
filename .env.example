# Mercado Libre: una sola app sirve para todas las cuentas/clientes.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://localhost:3000/api/ml/callback

# Postgres (Supabase). Conectate SIEMPRE con el rol `app_user` que crea
# db/postgres/schema.sql — nunca con el usuario `postgres` ni con la
# service_role key de Supabase, porque esos dos bypasean Row Level Security
# y anulan el aislamiento entre cuentas. Ver README para el paso a paso.
DATABASE_URL=postgres://app_user:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Login (NextAuth) para que cada cliente vea solo su cuenta.
# Los dos proveedores son opcionales e independientes: el que no tenga
# credenciales cargadas simplemente no aparece en la pantalla de login.
# Como la cuenta se identifica por email, entrar con Google o con Microsoft
# con el mismo email cae siempre en la misma cuenta.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login con Microsoft: Hotmail, Outlook, Live y cuentas de empresa
# (Microsoft Entra ID, ex Azure AD). Paso a paso en docs/login-microsoft.md.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
# 'common' (default si se deja vacío) admite cuentas personales Y de empresa.
# Un GUID de tenant restringe el login al directorio de esa organización.
AZURE_AD_TENANT_ID=common

NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Emails con acceso a todas las cuentas (separados por coma).
ADMIN_EMAILS=
