# Mercado Libre: una sola app sirve para todas las cuentas/clientes.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://localhost:3000/api/ml/callback

# Base de datos: en local usa un archivo SQLite; en producción (Vercel) apunta
# a una base Turso (libSQL) para que los datos persistan entre requests.
# Dejar vacío en local para usar el archivo de DB_PATH.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
DB_PATH=./data/ml-dashboard.db

# Login con Google (NextAuth) para que cada cliente vea solo su cuenta.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Emails con acceso a todas las cuentas (separados por coma).
ADMIN_EMAILS=
